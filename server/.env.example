PORT=3001
GEMINI_API_KEY=your-key-here
# Optional: preferred model, tried first. Lighter models are used as automatic
# fallbacks when it is overloaded. Default: gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
# Optional: max /api/analyze requests per IP per 15 minutes (default 10)
# ANALYZE_RATE_LIMIT=10
# Optional: max /api/translate requests per IP per 15 minutes (default 30)
# TRANSLATE_RATE_LIMIT=30
